# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Database (Postgres, e.g. Neon) ---
DATABASE_URL=
# Direct (non-pooled) connection, used only for migrations
DIRECT_URL=

# --- Site / SEO ---
# Production canonical origin. Must be the real custom domain, never localhost or a preview URL.
NEXT_PUBLIC_SITE_URL=https://ntkb-auto-review-deals-jet.vercel.app

# --- Admin session / secrets (server-only, never exposed to the client) ---
SESSION_SECRET=
CONTENT_ENGINE_ENCRYPTION_KEY=

# --- Bootstrap admin (used once by `npm run seed`) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Content Generation Engine (Keyword-to-Blog API) ---
# CONTENT_ENGINE_MOCK_MODE must be false in production, and requires the fields below.
# API key is read server-side only (lib/content-engine/config.ts) — never sent to the
# browser, logged, or persisted anywhere but encrypted-at-rest in the database.
CONTENT_ENGINE_MOCK_MODE=true
CONTENT_ENGINE_API_BASE_URL=
CONTENT_ENGINE_API_ENDPOINT=https://keyword-to-blog-docs-git-main-ad-quark-private-limited.vercel.app/v1/generate
CONTENT_ENGINE_API_KEY=

# --- Google Search Console (optional; submission is skipped and marked FAILED with a clear reason if unset) ---
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_PROPERTY_URL=

# --- Analytics (optional; app must not break if unset) ---
NEXT_PUBLIC_ANALYTICS_ID=G-CX72T738Y5

# --- Scheduled content refresh (optional) ---
# Shared secret an external scheduler (e.g. Vercel Cron) sends as the
# x-refresh-secret header when calling POST /api/refresh. Leave unset to disable
# the endpoint entirely (manual refresh in the admin UI works without it).
CONTENT_REFRESH_SECRET=

# --- Affiliate network fallback (optional; only used when no admin mapping
# exists and networkFallbackEnabled is on in Admin -> Settings) ---
EXAMPLE_NETWORK_API_KEY=
